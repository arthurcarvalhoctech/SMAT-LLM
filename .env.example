# LLM provider configuration.
# Copy this file to .env and fill in the key. .env is gitignored.
#
# Supported providers:
#   deepseek | openai | openrouter | together | groq | gemini | anthropic
#   ollama | vllm | lmstudio | custom | openai-compatible
#
# Environment variables always take precedence over env-config.json.

# --- DeepSeek (OpenAI-compatible) ---
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-key

# Generic key, accepted by any provider:
# LLM_API_KEY=your-key

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your-openai-key

# --- OpenRouter / Together / Groq (OpenAI-compatible) ---
# LLM_PROVIDER=openrouter
# LLM_MODEL=deepseek/deepseek-chat
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=your-openrouter-key

# --- Gemini (native) ---
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your-gemini-key

# --- Anthropic (native) ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_API_KEY=your-anthropic-key

# --- Ollama (local, no API key) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://host.docker.internal:11434
# For a local (non-Docker) run, use http://localhost:11434

# --- Generic OpenAI-compatible endpoint (vLLM, LM Studio, ...) ---
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=your-model
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=optional-key

# --- Optional overrides ---
# LLM_MODEL_KEY=deepseek
# LLM_TEMPERATURE=0.0
# LLM_SEED=42
# LLM_TIMEOUT_SECONDS=300
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_NUM_OUTPUTS=1
# LLM_PROMPT_KEYS=prompt1,prompt2,prompt3,prompt4,prompt5
# LLM_PROMPT_TEMPLATE=zero_shot

# Optional: override the input JSON path for local execution.
# SMAT_INPUT_PATH=/home/arthur/UFPE/SMAT-Gemini/input-smat-mergedataset.json

# --- Dynamic interference detection pipeline ---
# true (default): generate/execute tests and detect dynamic interference.
# false: skip the pipeline and print that the test-based flow is not active.
SMAT_DYNAMIC_INTERFERENCE_DETECTION=true

# --- Laya pre-analysis flow (optional) ---
# Requires the optional `laya` package (pip install -r SMAT/requirements-laya.txt)
# and downloads model weights on first use.
# false (default): do not run the Laya pre-analysis.
SMAT_LAYA_INTERFERENCE_DETECTION=false
SMAT_LAYA_MODEL=english
SMAT_LAYA_THRESHOLD=0.5
SMAT_LAYA_MAX_LEN=512
# SMAT_LAYA_LOG_DIR=/app/output-test-dest/reports/laya

# Docker build arg: set to true to install the optional Laya dependency.
# INSTALL_LAYA=false
