# LLM provider configuration.
# Copy this file to .env and fill in the key. .env is gitignored.
#
# Supported providers:
#   deepseek | openai | openrouter | together | groq | gemini | anthropic
#   ollama | vllm | lmstudio | custom | openai-compatible
#
# Environment variables always take precedence over env-config.json.

# --- DeepSeek (OpenAI-compatible) ---
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-key

# Generic key, accepted by any provider:
# LLM_API_KEY=your-key

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your-openai-key

# --- OpenRouter / Together / Groq (OpenAI-compatible) ---
# LLM_PROVIDER=openrouter
# LLM_MODEL=deepseek/deepseek-chat
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=your-openrouter-key

# --- Gemini (native) ---
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your-gemini-key

# --- Anthropic (native) ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_API_KEY=your-anthropic-key

# --- Ollama (local, no API key) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://host.docker.internal:11434
# For a local (non-Docker) run, use http://localhost:11434

# --- Generic OpenAI-compatible endpoint (vLLM, LM Studio, ...) ---
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=your-model
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=optional-key

# --- Optional overrides ---
LLM_MODEL_KEY=deepseek
LLM_TEMPERATURE=0.0
LLM_SEED=42
# LLM_TIMEOUT_SECONDS=300
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_NUM_OUTPUTS=1
LLM_PROMPT_KEYS=prompt1,prompt2,prompt3,prompt4,prompt5
# LLM_PROMPT_TEMPLATE=zero_shot

# Optional: override the input JSON path for local execution.
SMAT_INPUT_PATH=/app/input-smat-mergedataset.json

# --- Dynamic interference detection pipeline ---
# true (default): generate/execute tests and detect dynamic interference.
# false: skip the pipeline and print that the test-based flow is not active.
SMAT_DYNAMIC_INTERFERENCE_DETECTION=true

# --- Laya pre-analysis flow (optional) ---
# Requires the optional `laya` package (pip install -r SMAT/requirements-laya.txt)
# and downloads model weights on first use.
# false (default): do not run the Laya pre-analysis.
SMAT_LAYA_INTERFERENCE_DETECTION=false
SMAT_LAYA_MODEL=english
SMAT_LAYA_THRESHOLD=0.5
# baseline | consistent | conservative
SMAT_LAYA_DECISION_RULE=baseline
# json | compact
SMAT_LAYA_STATE_FORMAT=json
# Ask a witness (choice) question before the criteria.
SMAT_LAYA_WITNESS=false
# Run the witness in a separate call before the criteria.
SMAT_LAYA_WITNESS_TWO_STAGE=false
# Reproduction only: keep baseline even when witness is enabled (the original
# 2026-11-01 13:25 run used witness=true with decision_rule=baseline).
SMAT_LAYA_ALLOW_BASELINE_WITH_WITNESS=false
# Appends the per-criterion negative instructions to the criteria prompts.
# false restores the pre-2026-11-01 prompt used by run 132519_636160.
SMAT_LAYA_NEGATIVE_INSTRUCTIONS=true
# affected_branch/analysis_confidence are not used by the decision rules.
SMAT_LAYA_DIAGNOSTIC_QUESTIONS=false
# Optional C1,C2,C3 thresholds; empty uses SMAT_LAYA_THRESHOLD.
SMAT_LAYA_THRESHOLDS=0.91,0.91,0.91
SMAT_LAYA_MAX_LEN=512
# Directory must stay inside SMAT/output-test-dest so the viewer can read it.
# Docker path: /app/SMAT/output-test-dest/reports/laya
# If unset, the default is <cwd>/output-test-dest/reports/laya (cwd is SMAT).
SMAT_LAYA_LOG_DIR=/app/SMAT/output-test-dest/reports/laya

# --- LLM interference pre-analysis (optional) ---
# Uses the LLM_PROVIDER/LLM_MODEL/API key configured at the top of this file.
# false (default): do not call the LLM for merge scenarios.
SMAT_LLM_INTERFERENCE_DETECTION=false
SMAT_LLM_INTERFERENCE_THRESHOLD=0.5
SMAT_LLM_INTERFERENCE_MAX_INPUT_CHARS=24000
# Optional flow-specific model. Empty inherits LLM_MODEL.
# deepseek-flash preserved the accuracy observed in run 130227.
SMAT_LLM_INTERFERENCE_MODEL=
# Used only when finish_reason=length; deepseek-chat is the safe fallback.
SMAT_LLM_INTERFERENCE_FALLBACK_MODEL=deepseek-chat
SMAT_LLM_INTERFERENCE_MAX_OUTPUT_TOKENS=8192
# JSON mode is optional; it can change outputs. Disabled for accuracy here.
SMAT_LLM_INTERFERENCE_JSON_MODE=false
# Retry once with fallback model or double output budget when finish_reason=length.
SMAT_LLM_INTERFERENCE_RETRY_ON_LENGTH=true
# Keep under SMAT/output-test-dest so the viewer can read it.
# SMAT_LLM_INTERFERENCE_LOG_DIR=/app/SMAT/output-test-dest/reports/llm_interference

# --- Hugging Face cache/download settings for Laya ---
# Host directory bind-mounted into the container as the HF cache.
HF_CACHE_DIR=/home/arthur/.cache/huggingface
# 0 on the first run (download); 1 after the checkpoint is cached.
HF_HUB_OFFLINE=0
# Avoids the Xet transfer path, which can stall in some Docker/network setups.
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=120
HF_HUB_ETAG_TIMEOUT=30

# Docker build arg: torch wheel index. CPU by default; use a CUDA index if needed.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Docker build arg: set to true to install the optional Laya dependency.
INSTALL_LAYA=false

# Port for the scenario viewer (docker compose up viewer).
# VIEWER_PORT=3000

# Dataset root (mergedataset checkout). The input JSON uses ${PATH_DATASET}/...
# It must contain <project>/<hash>/source/<Class>/{base,left,right,merge}.java
# and the transformed/original jars.
PATH_DATASET=/path/to/mergedataset

# Diff-based filter for the LLM test generator: true keeps only the class
# fields used by the method or touched by the change (default: false).
# SMAT_CONTEXT_FILTER=false

# Pasta com checkpoints locais do Laya (ex.: modelo ajustado), montada em /laya_smat (somente leitura).
# Use SMAT_LAYA_MODEL=/laya_smat/<pasta do checkpoint> para carregá-lo.
LAYA_SMAT_DIR=./.laya_smat
